# Grapevined reads one environment variable: the local passphrase that unlocks
# grapevined.json. Set it to whatever you chose with `init --passphrase`.
#
# A fresh clone has no store, so nothing here is required until you run:
#   python3 grapevined.py init --passphrase <phrase>
#
# The value below is the documented demo credential (demo identity
# cenius@cenius.ai / cenius) used by demo.sh and the README quick start, so
# `cp .env.example .env` plus the documented commands works with zero edits.
GRAPEVINED_PASSPHRASE=cenius
